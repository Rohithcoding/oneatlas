// OneAtlas data model
// PostgreSQL + Prisma. All product data (models, labs, providers, listings,
// benchmarks and scores) is stored here and exposed only through API routes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ModelType {
  TEXT
  IMAGE
  VIDEO
  EMBEDDING
  SPEECH
  TRANSCRIPTION
  RERANKING
  REALTIME
}

enum BenchmarkCategory {
  CODING
  REASONING
  MATH
  SCIENCE
  LANGUAGE
  VISION
  AGENTIC
}

model Lab {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @db.Text
  website     String?
  country     String?
  founded     Int?
  color       String   @default("#6366f1")
  models      Model[]
  createdAt   DateTime @default(now())

  @@index([name])
}

model Provider {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  website   String?
  category  String          @default("Inference API")
  region    String?
  color     String          @default("#0ea5e9")
  listings  ModelProvider[]
  createdAt DateTime        @default(now())

  @@index([name])
  @@index([category])
}

model Model {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  labId            String
  lab              Lab              @relation(fields: [labId], references: [id], onDelete: Cascade)
  type             ModelType        @default(TEXT)
  description      String           @db.Text
  contextWindow    Int?
  maxOutput        Int?
  inputPrice       Float?           // USD per 1M input tokens
  outputPrice      Float?           // USD per 1M output tokens
  cachePrice       Float?           // USD per 1M cached input tokens
  intelligence     Float?           // 0-100 composite index
  parameters       String?
  license          String?
  reasoning        Boolean          @default(false)
  toolCalling      Boolean          @default(false)
  structuredOutput Boolean          @default(false)
  vision           Boolean          @default(false)
  openWeights      Boolean          @default(false)
  free             Boolean          @default(false)
  deprecated       Boolean          @default(false)
  releasedAt       DateTime
  updatedAt        DateTime         @updatedAt
  listings         ModelProvider[]
  scores           BenchmarkScore[]
  createdAt        DateTime         @default(now())

  @@index([labId])
  @@index([type])
  @@index([releasedAt])
  @@index([inputPrice])
  @@index([intelligence])
  @@index([name])
}

model ModelProvider {
  id            String   @id @default(cuid())
  modelId       String
  model         Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  providerId    String
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  inputPrice    Float?
  outputPrice   Float?
  cachePrice    Float?
  contextWindow Int?
  throughput    Float?   // output tokens / second
  latencyMs     Float?   // time to first token
  available     Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@unique([modelId, providerId])
  @@index([providerId])
}

model Benchmark {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  category    BenchmarkCategory
  description String           @db.Text
  maxScore    Float            @default(100)
  unit        String           @default("%")
  scores      BenchmarkScore[]
  createdAt   DateTime         @default(now())

  @@index([category])
}

model BenchmarkScore {
  id          String    @id @default(cuid())
  modelId     String
  model       Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  benchmarkId String
  benchmark   Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
  score       Float
  rank        Int?
  updatedAt   DateTime  @updatedAt

  @@unique([modelId, benchmarkId])
  @@index([benchmarkId, score])
}
